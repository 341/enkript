{
  "expo": {
    "name": "my-enkript",
    "slug": "my-enkript",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myenkript",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1E"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock Vault with Face ID.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.maxhuni.eroll.myenkript"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D1426"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.maxhuni.eroll.myenkript"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "./plugins/with-autofill-manifest.js"
    ],
    "extra": {
      "vaultRelayWsUrl": "",
      "router": {},
      "eas": {
        "projectId": "88c70083-ccf1-45a8-9e75-c8ee2674357e"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "maxhuni.eroll"
  }
}
